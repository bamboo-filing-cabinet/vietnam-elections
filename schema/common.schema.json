{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "common.schema.json",
  "title": "Common definitions for Vietnam Elections data exports",
  "$defs": {
    "document": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "cycle_id": { "type": ["string", "null"] },
        "title": { "type": "string" },
        "url": { "type": ["string", "null"], "format": "uri" },
        "file_path": { "type": ["string", "null"] },
        "doc_type": {
          "type": "string",
          "enum": ["pdf", "web", "docx", "csv", "json"]
        },
        "published_date": { "type": ["string", "null"], "format": "date" },
        "fetched_date": { "type": ["string", "null"], "format": "date" },
        "notes": { "type": ["string", "null"] },
        "terms_status": { "$ref": "#/$defs/terms_status" },
        "terms_url": { "type": ["string", "null"] },
        "terms_checked_at": { "type": ["string", "null"], "format": "date" },
        "terms_notes": { "type": ["string", "null"] }
      },
      "required": ["id", "title", "doc_type"]
    },
    "source": {
      "type": "object",
      "properties": {
        "field": { "type": "string" },
        "document_id": { "type": "string" },
        "title": { "type": "string" },
        "url": { "type": ["string", "null"], "format": "uri" },
        "doc_type": {
          "type": "string",
          "enum": ["pdf", "web", "docx", "csv", "json"]
        },
        "published_date": { "type": ["string", "null"], "format": "date" },
        "fetched_date": { "type": ["string", "null"], "format": "date" },
        "notes": { "type": ["string", "null"] }
      },
      "required": ["field", "document_id", "title", "doc_type"]
    },
    "annotation": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "status": { "$ref": "#/$defs/result_status" },
        "reason": { "type": ["string", "null"] },
        "effective_date": { "type": ["string", "null"], "format": "date" },
        "source": { "$ref": "#/$defs/document" },
        "notes": { "type": ["string", "null"] }
      },
      "required": ["id", "status", "source"]
    },
    "result_status": {
      "type": "string",
      "enum": ["won", "lost", "not_confirmed"]
    },
    "terms_status": {
      "type": ["string", "null"],
      "enum": ["GOV_PUBLIC_INFO", "UNKNOWN", null]
    },
    "cycle_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+-[0-9]{4}$",
      "description": "Election cycle identifier, e.g. na15-2021"
    },
    "iso_datetime": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    }
  }
}
